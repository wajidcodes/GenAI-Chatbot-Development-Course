    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nreturn String(cfg.search_keywords).split(',')\n  .map(s => s.trim()).filter(Boolean)\n  .map(kw => ({ json: { title: kw, location: cfg.location, rows: cfg.rows_per_keyword } }));"
      },
      "id": "q",
      "name": "Build Search Queries",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1460,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.apify.com/v2/acts/' + $('Config').first().json.apify_actor_id + '/run-sync-get-dataset-items?timeout=280' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.title, location: $json.location, rows: Number($json.rows) }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "apify",
      "name": "Apify - Scrape LinkedIn Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1240,
        280
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Apify API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const SKILLS = {\n  'Full-Stack': /full[\\s-]?stack/i,\n  'Next.js': /next\\.?js/i,\n  'Python': /\\bpython\\b/i,\n  'Machine Learning': /machine[\\s-]?learning|\\bML\\b/i,\n  'LangChain': /lang[\\s-]?chain/i,\n  'RAG / LLM': /\\bRAG\\b|retrieval[\\s-]augmented|\\bLLMs?\\b/i\n};\nconst EMAIL_RE = /[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}/g;\nconst BAD = /(noreply|no-reply|donotreply|linkedin\\.com|example\\.com|sentry|\\.png|\\.jpg)/i;\nconst DRY = $('Config').first().json.dry_run === true;\nconst seen = new Set();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  if (!j.title && !j.jobTitle) continue;\n  const title = j.title || j.jobTitle || '';\n  const desc = String(j.descriptionText || j.description || j.jobDescription || '');\n  const url = j.jobUrl || j.link || j.url || '';\n  const id = String(j.id || j.jobId || url || (title + '|' + (j.companyName || '')));\n  if (seen.has(id)) continue;\n  seen.add(id);\n\n  const hay = title + '\\n' + desc;\n  const matched = Object.keys(SKILLS).filter(k => SKILLS[k].test(hay));\n  const titleHit = Object.values(SKILLS).some(r => r.test(title));\n  if (!(matched.length >= 2 || titleHit)) continue;\n\n  const candidates = [j.contactEmail, j.hiringManagerEmail, j.recruiterEmail, j.companyEmail, j.applyEmail]\n    .concat(desc.match(EMAIL_RE) || [])\n    .filter(e => e && !BAD.test(e));\n\n  out.push({ json: {\n    job_id: id,\n    job_title: title,\n    company: j.companyName || j.company || '',\n    location: j.location || '',\n    job_url: url,\n    description: desc.slice(0, 6000),\n    matched_keywords: matched,\n    contact_email: candidates.length ? String(candidates[0]).toLowerCase() : (DRY ? 'no-email-found (dry run)' : ''),\n    poster_name: j.posterName || j.posterFullName || '',\n    poster_profile_url: j.posterProfileUrl || ''\n  }});\n}\nreturn out;"
      },
