{
  "name": "RAG 1 - Document Ingestion (Gmail to Pinecone)",
  "nodes": [
    {
      "parameters": {
        "content": "## Workflow 1 - Document Ingestion\nGmail (attachments) -> split attachments -> extract text -> chunk -> OpenAI text-embedding-3-large (3072) -> Pinecone index `n8n-document-rag`, namespace `documents`.\n\nSupported: PDF, TXT, DOCX. Other file types are skipped.\nSetup: Gmail OAuth2, OpenAI API, Pinecone API credentials. Create the Pinecone index first (dimension 3072, cosine).",
        "height": 260,
        "width": 520,
        "color": 5
      },
      "id": "sticky-1",
      "name": "Note - Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -1500,
        -60
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "has:attachment",
          "readStatus": "unread"
        },
        "options": {
          "downloadAttachments": true,
          "attachmentPrefix": "attachment_"
        }
      },
      "id": "w1-trigger",
      "name": "Gmail Trigger (Documents)",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        -1500,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail OAuth2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst allowed = ['pdf', 'txt', 'docx'];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const headers = j.headers || {};\n  const fromRaw = headers.from || j.From || '';\n  const m = String(fromRaw).match(/<([^>]+)>/);\n  const sender = (m ? m[1] : String(fromRaw)).trim();\n  const subject = headers.subject || j.Subject || '';\n  const keys = Object.keys(item.binary || {});\n  keys.forEach((key, idx) => {\n    const bin = item.binary[key];\n    const fileName = bin.fileName || key;\n    const ext = (fileName.split('.').pop() || '').toLowerCase();\n    if (!allowed.includes(ext)) { return; } // unsupported type: skipped\n    out.push({\n      json: {\n        message_id: j.id,\n        thread_id: j.threadId,\n        sender_email: sender,\n        email_subject: subject,\n        filename: fileName,\n        extension: ext,\n        content_type: bin.mimeType || '',\n        attachment_id: j.id + '_' + idx,\n        document_id: j.id + '_' + fileName,\n        upload_timestamp: new Date().toISOString()\n      },\n      binary: { data: bin }\n    });\n  });\n}\nreturn out;"
      },
